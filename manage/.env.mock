# 打包路径
VITE_BASE_URL = /
VITE_IS_REQUEST_PROXY = true

# Mock 模式下前端直接消费本地数据，不经后端代理
# 这里留空即可，vite.config.ts 的 proxy 在 mock 开启时不会被命中
VITE_API_URL = ''

# 启用本地 Mock 数据
# `npm run dev:mock` 会使用本文件，等价于 VITE_USE_MOCK = true
VITE_USE_MOCK = true

# 接口前缀。
# 说明：请求会先拼接 VITE_API_URL_PREFIX 再拼接 src/api 中的路径，
# 因此 Mock handler 的注册路径必须包含同样的前缀。
# 项目既有 mock（mock/index.ts）同样使用 /api 前缀，此处保持一致。
VITE_API_URL_PREFIX = /api
