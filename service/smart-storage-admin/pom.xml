    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.5.1</version>
                <configuration>
                    <!-- 允许使用 HTTP 协议连接非 HTTPS 的 Harbor 仓库 -->
                    <allowInsecureRegistries>true</allowInsecureRegistries>
                    <containerizingMode>packaged</containerizingMode>
                    <!-- 指定基础镜像 -->
                    <from>
                        <image>127.0.0.1:48143/base-images/bellsoft-liberica-openjdk-debian:21.0.10</image>
                    </from>
                    <!-- 指定目标镜像地址和认证信息 -->
                    <to>

                        <image>127.0.0.1:48143/inhouse-project-zhlc/admin-service-site:latest</image>
                        <auth>
                            <username>admin</username>
                            <password>${env.SMART_STORAGE_REGISTRY_PASSWORD}</password>
                        </auth>
                    </to>
                    <container>
                        <!-- 指定应用主类 -->
                        <mainClass>com.chinaunicom.smartstorage.admin.WebAdminApplication</mainClass>
                        <environment>
                            <TZ>Asia/Shanghai</TZ>
                        </environment>
                        <!-- 设置JVM参数 -->
                        <jvmFlags>
                            <jvmFlag>--add-opens=java.base/java.lang=ALL-UNNAMED</jvmFlag>
                            <jvmFlag>-Xms1024m</jvmFlag>
                            <jvmFlag>-Xmx1024m</jvmFlag>
                            <jvmFlag>-Dspring.profiles.active=site</jvmFlag>
                        </jvmFlags>
                    </container>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>repackage</id>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <mainClass>com.chinaunicom.smartstorage.admin.WebAdminApplication</mainClass>
                    <jvmArguments>-Dfile.encoding=utf-8</jvmArguments>
