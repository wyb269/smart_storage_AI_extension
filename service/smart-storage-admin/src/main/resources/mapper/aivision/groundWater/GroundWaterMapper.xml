<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  地面积水监测 Mapper

  ==================== 数据范围下推规则（唯一权威定义） ====================
  本文件的仓库范围条件共出现 <b>8 处</b>：
    EventFilters、listMonitorPoint、listRecentEvent、
    getEventSummaryInScope、getEventDetailInScope、
    getAlgorithmTaskByTaskNo、updateAlgorithmTaskOutcome、listAlgorithmTasksByEventId
  （listEventByCondition 与 listEventForExport 共用 EventFilters）

  八处形态必须完全一致：
    非全域 且有授权仓库  -> AND <别名>.warehouse_id IN (...)
    非全域 且无授权仓库  -> AND 1 = 0        （失败即拒绝，返回空集）
    全域               -> 不追加仓库条件

  修改任一处时必须同步其余各处：把「取不到授权维度」当成「不限制」
  等价于放弃越权防护。范围参数只能由 Service 从登录态构造，
  查询 DTO 中的 scope 字段标 @JsonIgnore。

  ⚠️ 授权仓库集合来自主库组织树 type=2 子树（AiVisionScopeResolver），
     与本库 warehouse_id 必须同源；不同源时 IN 条件会静默返回空集，
     页面表现为「一切正常但就是没数据」，不会报错。

  ⚠️ 新增查询时务必补上这一段，并同步更新上面的计数。
  ========================================================================
-->
<mapper namespace="com.chinaunicom.smartstorage.admin.mapper.aivision.groundWater.GroundWaterMapper">

    <!-- ========== 列表结果映射 ========== -->
    <resultMap id="EventResultMap" type="com.chinaunicom.smartstorage.admin.dto.groundWater.WaterEventRespDTO">
        <id     property="eventId"          column="event_id"/>
        <result property="eventNo"          column="event_no"/>
        <result property="occurredAt"       column="occurred_at"/>
        <result property="warehouseId"      column="warehouse_id"/>
        <result property="warehouseName"    column="warehouse_name"/>
        <result property="pointId"          column="point_id"/>
        <result property="pointName"        column="point_name"/>
        <result property="cameraCode"       column="camera_code"/>
        <result property="waterType"        column="water_type"/>
        <result property="waterTypeName"    column="water_type_name"/>
        <result property="algorithmStatus"  column="algorithm_status"/>
        <result property="algorithmResult"  column="algorithm_result"/>
        <result property="confidence"       column="confidence"/>
        <result property="processStatus"    column="process_status"/>
        <result property="processedBy"      column="processed_by"/>
        <result property="processedAt"      column="processed_at"/>
        <result property="processOpinion"   column="process_opinion"/>
        <result property="eventVersion"     column="event_version"/>
    </resultMap>

    <!-- 详情结果映射：在列表字段之上补描述、时长与模拟数据标识 -->
    <resultMap id="EventDetailResultMap"
               type="com.chinaunicom.smartstorage.admin.dto.groundWater.WaterEventDetailRespDTO"
               extends="EventResultMap">
        <result property="eventDesc"        column="event_desc"/>
        <result property="recoveredAt"      column="recovered_at"/>
        <result property="durationSeconds"  column="duration_seconds"/>
        <result property="isSimulated"      column="is_simulated"/>
    </resultMap>

    <!--
      ========== 时间列输出格式 ==========
      PostgreSQL 的 TIMESTAMP 经 MyBatis 转成 String 会带 6 位小数，
      统一在 SQL 侧格式化成 yyyy-MM-dd HH:mm:ss，让真实库与 Mock 响应完全同形。
      注意：排序仍用裸列，不用格式化后的字符串。
    -->
    <sql id="EventColumns">
        e.id                AS event_id,
        e.event_no,
        to_char(e.occurred_at, 'YYYY-MM-DD HH24:MI:SS')  AS occurred_at,
        e.warehouse_id, e.warehouse_name,
        e.point_id, e.point_name, e.camera_code,
        e.water_type, e.water_type_name,
        e.algorithm_status, e.algorithm_result, e.confidence,
        e.process_status, e.processed_by,
        to_char(e.processed_at, 'YYYY-MM-DD HH24:MI:SS') AS processed_at,
        e.process_opinion, e.event_version
    </sql>

    <sql id="EventDetailColumns">
        <include refid="EventColumns"/>,
        e.event_desc,
        to_char(e.recovered_at, 'YYYY-MM-DD HH24:MI:SS') AS recovered_at,
        e.duration_seconds, e.is_simulated
    </sql>

    <!-- ========== 公共筛选条件 ========== -->
    <sql id="EventFilters">
        <where>
            <if test="query.eventNo != null and query.eventNo != ''">
                AND e.event_no LIKE CONCAT('%', #{query.eventNo}, '%')
            </if>
            <!-- warehouseId / pointId 为 Long：BIGINT 列不接受 varchar 绑定，故只判空 -->
            <if test="query.warehouseId != null">
                AND e.warehouse_id = #{query.warehouseId}
            </if>
            <if test="query.pointId != null">
                AND e.point_id = #{query.pointId}
            </if>
            <if test="query.cameraCode != null and query.cameraCode != ''">
                AND e.camera_code LIKE CONCAT('%', #{query.cameraCode}, '%')
            </if>
            <if test="query.waterType != null and query.waterType != ''">
                AND e.water_type = #{query.waterType}
            </if>
            <if test="query.processStatus != null and query.processStatus != ''">
                <choose>
                    <when test="query.processStatus == 'PENDING'">
                        AND e.process_status IN ('PENDING', 'PROCESSING')
                    </when>
                    <otherwise>
                        AND e.process_status = #{query.processStatus}
                    </otherwise>
                </choose>
            </if>
            <!-- 行政区筛选：来自前端业务条件（TimeBaseQueryDTO），不是数据范围 -->
            <if test="query.regionId != null and query.regionId != ''">
                AND e.region_id = #{query.regionId}
            </if>
            <!--
              Service 从登录态注入的仓库数据范围。
              与业务筛选条件以 AND 叠加，且不接受前端传入
              （scopeUnrestricted / scopeWarehouseIds 标了 @JsonIgnore）。
            -->
            <if test="!query.scopeUnrestricted">
                <choose>
                    <when test="query.scopeWarehouseIds != null and query.scopeWarehouseIds.size() > 0">
                        AND e.warehouse_id IN
                        <foreach collection="query.scopeWarehouseIds" item="wid"
                                 open="(" close=")" separator=",">
                            #{wid}
                        </foreach>
                    </when>
                    <otherwise>
                        AND 1 = 0
                    </otherwise>
                </choose>
            </if>
            <if test="query.startTime != null">
                AND e.occurred_at &gt;= #{query.startTime}
            </if>
            <if test="query.endTime != null">
                AND e.occurred_at &lt;= #{query.endTime}
            </if>
        </where>
    </sql>

    <!-- ========== 监测点位状态列表 ========== -->
    <select id="listMonitorPoint"
            resultType="com.chinaunicom.smartstorage.admin.dto.groundWater.MonitorPointStatusRespDTO">
        SELECT p.id              AS pointId,
               p.point_name      AS pointName,
               p.camera_code     AS cameraCode,
               p.camera_id       AS platformCameraId,
               p.warehouse_id    AS warehouseId,
               p.warehouse_name  AS warehouseName,
               p.device_status   AS deviceStatus,
               p.alarm_status    AS alarmStatus,
               to_char(p.last_heartbeat_at, 'YYYY-MM-DD HH24:MI:SS') AS lastHeartbeatAt,
               to_char(p.latest_event_at,   'YYYY-MM-DD HH24:MI:SS') AS latestEventAt,
               p.sort_no         AS sortNo
        FROM ai_water_monitor_point p
        <where>
            <!-- 数据范围块 1 / 5 -->
            <if test="!unrestricted">
                <choose>
                    <when test="warehouseIds != null and warehouseIds.size() > 0">
                        AND p.warehouse_id IN
                        <foreach collection="warehouseIds" item="wid"
                                 open="(" close=")" separator=",">
                            #{wid}
                        </foreach>
                    </when>
                    <otherwise>
                        AND 1 = 0
                    </otherwise>
                </choose>
            </if>
            AND p.enabled = TRUE
        </where>
        ORDER BY p.sort_no ASC
    </select>

    <!-- ========== 首页最近事件 ========== -->
    <select id="listRecentEvent" resultMap="EventResultMap">
        SELECT <include refid="EventColumns"/>
        FROM ai_water_event e
        <where>
            <!-- 数据范围块 2 / 5 -->
            <if test="!unrestricted">
                <choose>
                    <when test="warehouseIds != null and warehouseIds.size() > 0">
                        AND e.warehouse_id IN
                        <foreach collection="warehouseIds" item="wid"
                                 open="(" close=")" separator=",">
                            #{wid}
                        </foreach>
                    </when>
                    <otherwise>
                        AND 1 = 0
                    </otherwise>
                </choose>
            </if>
        </where>
        ORDER BY e.occurred_at DESC
        LIMIT #{limit}
    </select>

    <!-- ========== 历史分页查询 ========== -->
    <select id="listEventByCondition" resultMap="EventResultMap">
        SELECT <include refid="EventColumns"/>
        FROM ai_water_event e
        <!-- 数据范围块 3 / 5（EventFilters，同时服务导出） -->
        <include refid="EventFilters"/>
        <choose>
            <when test="query.orderByOccurredDesc != null and !query.orderByOccurredDesc">
                ORDER BY e.occurred_at ASC
            </when>
            <otherwise>
                ORDER BY e.occurred_at DESC
            </otherwise>
        </choose>
    </select>

    <!-- ========== 导出查询（不分页，受 limit 约束） ========== -->
    <select id="listEventForExport" resultMap="EventResultMap">
        SELECT <include refid="EventColumns"/>
        FROM ai_water_event e
        <include refid="EventFilters"/>
        ORDER BY e.occurred_at DESC
        LIMIT #{limit}
    </select>

    <!--
      ========== 事件主记录（带数据范围，越权校验） ==========
      仓库约束必须写在 SQL 里：EventColumns 不含 org_id / region_id，
      取回整行后在 Java 判断会因字段缺失而无法比较。
    -->
    <select id="getEventSummaryInScope" resultMap="EventResultMap">
        SELECT <include refid="EventColumns"/>
        FROM ai_water_event e
        WHERE e.id = #{eventId}
        <!-- 数据范围块 4 / 5 -->
        <if test="!unrestricted">
            <choose>
                <when test="warehouseIds != null and warehouseIds.size() > 0">
                    AND e.warehouse_id IN
                    <foreach collection="warehouseIds" item="wid"
                             open="(" close=")" separator=",">
                        #{wid}
                    </foreach>
                </when>
                <otherwise>
                    AND 1 = 0
                </otherwise>
            </choose>
        </if>
    </select>

    <!-- ========== 事件详情（带数据范围） ========== -->
    <select id="getEventDetailInScope" resultMap="EventDetailResultMap">
        SELECT <include refid="EventDetailColumns"/>
        FROM ai_water_event e
        WHERE e.id = #{eventId}
        <!-- 数据范围块 5 / 5 -->
        <if test="!unrestricted">
            <choose>
                <when test="warehouseIds != null and warehouseIds.size() > 0">
                    AND e.warehouse_id IN
                    <foreach collection="warehouseIds" item="wid"
                             open="(" close=")" separator=",">
                        #{wid}
                    </foreach>
                </when>
                <otherwise>
                    AND 1 = 0
                </otherwise>
            </choose>
        </if>
    </select>

    <!--
      ========== 证据列表 ==========
      库里存的是受控对象存储引用，这里原样带回列别名即 DTO 字段名，
      由 Service 经 MediaGateway 换成短时地址后才返回前端。
    -->
    <select id="listEvidenceByEventId"
            resultType="com.chinaunicom.smartstorage.admin.dto.groundWater.WaterEvidenceRespDTO">
        SELECT v.id             AS evidenceId,
               v.evidence_type  AS evidenceType,
               v.original_ref   AS originalUrl,
               v.annotated_ref  AS annotatedUrl,
               v.thumbnail_ref  AS thumbnailUrl,
               to_char(v.captured_at, 'YYYY-MM-DD HH24:MI:SS') AS capturedAt,
               v.camera_code    AS cameraCode,
               v.content_hash   AS contentHash,
               v.sort_no        AS sortNo
        FROM ai_water_evidence v
        WHERE v.event_id = #{eventId}
        ORDER BY v.sort_no ASC
    </select>

    <!-- ========== 处理审计记录（追加式全量历史） ========== -->
    <select id="listProcessRecords"
            resultType="com.chinaunicom.smartstorage.admin.dto.groundWater.ProcessRecordRespDTO">
        SELECT r.id              AS recordId,
               r.status_before   AS statusBefore,
               r.status_after    AS statusAfter,
               r.process_result  AS processResult,
               r.process_opinion AS processOpinion,
               r.processed_by    AS processedBy,
               to_char(r.processed_at, 'YYYY-MM-DD HH24:MI:SS') AS processedAt,
               r.source          AS source
        FROM ai_water_process_record r
        WHERE r.event_id = #{eventId}
        ORDER BY r.processed_at ASC
    </select>

    <!--
      ========== 人工处理：乐观锁更新 ==========

      关键点：
      1. WHERE 含 event_version，版本不匹配则更新 0 行；
      2. 只更新人工处理相关字段，不触碰 algorithm_status 与 algorithm_result；
      3. event_version 自增，供下次提交使用；
      4. process_status <> 'DONE'，保证已处理事件不被重复处理。
         三态模型下 DONE 是唯一的终态，PENDING 与 PROCESSING 仍可推进。

      ⚠️ 参数名必须与 Mapper 接口声明逐字一致。
      仓门异动那一版把 processed_at 写成 #{processedAt}，而接口只有 updatedAt，
      运行期抛「Parameter 'processedAt' not found」，导致写路径从来没成功过一次。
    -->
    <update id="updateProcessWithVersion">
        UPDATE ai_water_event
        SET process_status   = #{processStatus},
            processed_by     = #{processedBy},
            processed_at     = #{updatedAt},
            process_opinion  = #{processOpinion},
            event_version    = event_version + 1,
            updated_by       = #{processedBy},
            updated_at       = #{updatedAt}
        WHERE id = #{eventId}
          AND event_version = #{eventVersion}
          AND process_status &lt;&gt; 'DONE'
    </update>

    <!-- ========== 追加处理审计记录（只插入） ========== -->
    <insert id="appendProcessRecord">
        INSERT INTO ai_water_process_record (
            id, event_id, event_no, status_before, status_after,
            process_result, process_opinion, processed_by, processed_at,
            source, created_at
        ) VALUES (
            #{id}, #{eventId}, #{eventNo}, #{statusBefore}, #{statusAfter},
            #{processResult}, #{processOpinion}, #{processedBy}, #{processedAt},
            #{source}, #{createdAt}
        )
    </insert>

    <!--
      ========== 算法任务表（「重新识别」链路） ==========

      列映射按实体 AiWaterAlgorithmTask；时间保持裸 TIMESTAMP 由 Java 侧
      格式化（任务实体的 startedAt/finishedAt 是 LocalDateTime，不做 to_char）。
      media_refs / raw_result_ref 等内部引用不回传页面，故不查出。
    -->
    <resultMap id="AlgorithmTaskResultMap"
               type="com.chinaunicom.smartstorage.admin.entity.groundWater.AiWaterAlgorithmTask">
        <id     property="id"                   column="id"/>
        <result property="taskNo"               column="task_no"/>
        <result property="eventId"              column="event_id"/>
        <result property="pointId"              column="point_id"/>
        <result property="cameraId"             column="camera_id"/>
        <result property="cameraCode"           column="camera_code"/>
        <result property="warehouseId"          column="warehouse_id"/>
        <result property="taskType"             column="task_type"/>
        <result property="executionStatus"      column="execution_status"/>
        <result property="conclusion"           column="conclusion"/>
        <result property="waterType"            column="water_type"/>
        <result property="confidence"           column="confidence"/>
        <result property="modelName"            column="model_name"/>
        <result property="modelVersion"         column="model_version"/>
        <result property="algorithmVersion"     column="algorithm_version"/>
        <result property="configVersion"        column="config_version"/>
        <result property="startedAt"            column="started_at"/>
        <result property="finishedAt"           column="finished_at"/>
        <result property="inferenceDurationMs"  column="inference_duration_ms"/>
        <result property="detections"           column="detections"/>
        <result property="errorCode"            column="error_code"/>
        <result property="errorMessage"         column="error_message"/>
        <result property="retryCount"           column="retry_count"/>
        <result property="traceId"              column="trace_id"/>
        <result property="isSimulated"          column="is_simulated"/>
        <result property="createdBy"            column="created_by"/>
        <result property="createdAt"            column="created_at"/>
    </resultMap>

    <sql id="AlgorithmTaskColumns">
        t.id, t.task_no, t.event_id, t.point_id, t.camera_id, t.camera_code,
        t.warehouse_id, t.task_type,
        t.execution_status, t.conclusion, t.water_type, t.confidence,
        t.model_name, t.model_version, t.algorithm_version, t.config_version,
        t.started_at, t.finished_at, t.inference_duration_ms,
        t.detections, t.error_code, t.error_message,
        t.retry_count, t.trace_id, t.is_simulated, t.created_by, t.created_at
    </sql>

    <!-- ========== 落一行任务（提交受理） ========== -->
    <insert id="insertAlgorithmTask">
        INSERT INTO ai_water_algorithm_task (
            id, task_no, event_id, point_id, camera_id, camera_code,
            warehouse_id, region_id, org_id,
            task_type, media_type, media_refs, normal_reference_ref, roi,
            execution_status, conclusion, water_type, confidence,
            model_name, model_version, algorithm_version, config_version,
            confidence_threshold, media_digest,
            started_at, finished_at, inference_duration_ms,
            detections, evidence_refs, raw_result_ref,
            error_code, error_message, retry_count, trace_id,
            is_simulated, created_by, created_at, updated_by, updated_at
        ) VALUES (
            #{task.id}, #{task.taskNo}, #{task.eventId}, #{task.pointId},
            #{task.cameraId}, #{task.cameraCode},
            #{task.warehouseId}, #{task.regionId}, #{task.orgId},
            #{task.taskType}, #{task.mediaType}, #{task.mediaRefs},
            #{task.normalReferenceRef}, #{task.roi},
            #{task.executionStatus}, #{task.conclusion}, #{task.waterType},
            #{task.confidence},
            #{task.modelName}, #{task.modelVersion}, #{task.algorithmVersion},
            #{task.configVersion}, #{task.confidenceThreshold}, #{task.mediaDigest},
            #{task.startedAt}, #{task.finishedAt}, #{task.inferenceDurationMs},
            #{task.detections}, #{task.evidenceRefs}, #{task.rawResultRef},
            #{task.errorCode}, #{task.errorMessage}, #{task.retryCount}, #{task.traceId},
            #{task.isSimulated}, #{task.createdBy}, #{task.createdAt},
            #{task.updatedBy}, #{task.updatedAt}
        )
    </insert>

    <!-- ========== 按 task_no 取任务（带数据范围，块 6 / 8） ========== -->
    <select id="getAlgorithmTaskByTaskNo" resultMap="AlgorithmTaskResultMap">
        SELECT <include refid="AlgorithmTaskColumns"/>
        FROM ai_water_algorithm_task t
        WHERE t.task_no = #{taskNo}
        <if test="!unrestricted">
            <choose>
                <when test="warehouseIds != null and warehouseIds.size() > 0">
                    AND t.warehouse_id IN
                    <foreach collection="warehouseIds" item="wid"
                             open="(" close=")" separator=",">
                        #{wid}
                    </foreach>
                </when>
                <otherwise>
                    AND 1 = 0
                </otherwise>
            </choose>
        </if>
    </select>

    <!-- ========== 更新任务产出（块 7 / 8） ==========
         started_at 不回写：任务开始时间在受理落库时定格，
         「进行中可见时长」节流依赖它与当前时刻的比较。 -->
    <update id="updateAlgorithmTaskOutcome">
        UPDATE ai_water_algorithm_task
        SET execution_status      = #{task.executionStatus},
            conclusion            = #{task.conclusion},
            water_type            = #{task.waterType},
            confidence            = #{task.confidence},
            model_name            = #{task.modelName},
            model_version         = #{task.modelVersion},
            algorithm_version     = #{task.algorithmVersion},
            config_version        = COALESCE(#{task.configVersion}, config_version),
            finished_at           = #{task.finishedAt},
            inference_duration_ms = #{task.inferenceDurationMs},
            detections            = COALESCE(#{task.detections}, detections),
            evidence_refs         = COALESCE(#{task.evidenceRefs}, evidence_refs),
            raw_result_ref        = COALESCE(#{task.rawResultRef}, raw_result_ref),
            error_code            = #{task.errorCode},
            error_message         = #{task.errorMessage},
            retry_count           = #{task.retryCount},
            is_simulated          = #{task.isSimulated},
            updated_by            = #{updatedBy},
            updated_at            = #{updatedAt}
        WHERE task_no = #{task.taskNo}
        <if test="!unrestricted">
            <choose>
                <when test="warehouseIds != null and warehouseIds.size() > 0">
                    AND warehouse_id IN
                    <foreach collection="warehouseIds" item="wid"
                             open="(" close=")" separator=",">
                        #{wid}
                    </foreach>
                </when>
                <otherwise>
                    AND 1 = 0
                </otherwise>
            </choose>
        </if>
    </update>

    <!-- ========== 事件的算法任务列表（块 8 / 8） ==========
         started_at 可能为 NULL（极端脏数据），倒序时沉底而不是报错。 -->
    <select id="listAlgorithmTasksByEventId" resultMap="AlgorithmTaskResultMap">
        SELECT <include refid="AlgorithmTaskColumns"/>
        FROM ai_water_algorithm_task t
        WHERE t.event_id = #{eventId}
        <if test="!unrestricted">
            <choose>
                <when test="warehouseIds != null and warehouseIds.size() > 0">
                    AND t.warehouse_id IN
                    <foreach collection="warehouseIds" item="wid"
                             open="(" close=")" separator=",">
                        #{wid}
                    </foreach>
                </when>
                <otherwise>
                    AND 1 = 0
                </otherwise>
            </choose>
        </if>
        ORDER BY t.started_at DESC NULLS LAST, t.id DESC
        LIMIT #{limit}
    </select>

    <!-- ========== 事件算法侧字段回填 ==========
         只写算法侧列；process_status / event_version 一律不碰。
         confidence 直接覆盖（任务没产出置信度时事件同步显示「暂无」）；
         water_type 是 NOT NULL，只有任务给出新结论才改写。 -->
    <update id="writeBackEventAlgorithm">
        UPDATE ai_water_event
        SET algorithm_task_id = #{taskId},
            algorithm_status  = #{algorithmStatus},
            algorithm_result  = #{algorithmResult},
            confidence        = #{confidence},
            water_type        = COALESCE(#{waterType}, water_type),
            updated_by        = #{updatedBy},
            updated_at        = #{updatedAt}
        WHERE id = #{eventId}
    </update>

</mapper>
