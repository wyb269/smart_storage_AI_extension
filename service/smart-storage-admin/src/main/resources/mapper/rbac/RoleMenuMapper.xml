<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinaunicom.smartstorage.admin.mapper.rbac.RoleMenuLinkedMapper">
    <resultMap id="RoleGroupMap" type="com.chinaunicom.smartstorage.admin.entity.rbac.role.RoleMenuLinked">
        <result column="role_id" property="roleId"/>
        <result column="menu_id" property="menuId"/>
    </resultMap>
    <insert id="saveRoleMenuLinked">
        insert into base_role_menu (role_id, menu_id)
        VALUES
        <foreach collection="list" item="RoleMenuLinked" index="index" separator=",">
            (#{RoleMenuLinked.roleId}, #{RoleMenuLinked.menuId})
        </foreach>
    </insert>
    <delete id="deleteRoleMenuLinked">
        delete
        from base_role_menu
        where role_id = #{roleId}
    </delete>

    <delete id="deleteRoleMenuLinkedByMenuId" parameterType="integer">
        delete
        from base_role_menu where
        menu_id in
        <foreach collection="list" item="item" index="index" open="(" close=")" separator=",">
            #{item}
        </foreach>
    </delete>
</mapper>
