<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinaunicom.smartstorage.admin.mapper.rbac.MenuRightsMapper">
    <resultMap id="RoleGroupMap" type="com.chinaunicom.smartstorage.admin.entity.rbac.menu.MenuRightsLinked">
        <result column="menu_id" property="menuId"/>
        <result column="rights_id" property="rightsId"/>
    </resultMap>
    <insert id="saveMenuRightsLinked">
        insert into base_menu_rights (rights_id, menu_id)
        VALUES
        <foreach collection="list" item="MenuRightsLinked" index="index" separator=",">
            (#{MenuRightsLinked.rightsId}, #{MenuRightsLinked.menuId})
        </foreach>
    </insert>
</mapper>
