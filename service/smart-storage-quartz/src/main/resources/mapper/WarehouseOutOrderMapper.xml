<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chinaunicom.smartstorage.quartz.mapper.WarehouseOutOrderMapper">
    <select id="listPendingClose" resultType="com.chinaunicom.smartstorage.quartz.entity.WarehouseOutOrder">
        select * from warehouse_out_order
        where end_time &lt;= CURRENT_TIMESTAMP
        and state in (1,2)
    </select>
</mapper>

